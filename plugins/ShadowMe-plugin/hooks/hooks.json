{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "description": "会话启动时发送心跳",
        "hooks": [
          "bash ${CLAUDE_PLUGIN_ROOT}/scripts/heartbeat.sh"
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "description": "会话结束时报告当前进度",
        "hooks": [
          "bash ${CLAUDE_PLUGIN_ROOT}/scripts/report-progress.sh --final"
        ]
      }
    ]
  }
}
