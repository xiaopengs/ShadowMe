# ShadowMe Board URL
SHADOW_BOARD_URL=http://localhost:3000

# ShadowMe API Key - 从看板设置页面生成
# 1. 打开 http://localhost:3000/settings
# 2. 在 API Key 管理区域点击"生成新密钥"
# 3. 复制生成的 sm_ 开头的密钥粘贴到下面
SHADOW_API_KEY=

# GitLab Configuration (optional)
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=your-gitlab-token
GITLAB_DEFAULT_PROJECT=your-project-id

# Working Directory
WORKING_DIRECTORY=/path/to/your/work
