# ===========================================
# ShadowMe Environment Configuration
# ===========================================
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to version control

# ===========================================
# Database Configuration (Server-side only)
# ===========================================
# SQLite database file path (relative to project root)
DATABASE_PATH=./data/ShadowMe.db

# ===========================================
# GitLab Integration (Server-side)
# ===========================================
# GitLab server URL
GITLAB_URL=https://gitlab.example.com

# GitLab Personal Access Token (glpat-xxxxxxxxxxxx)
GITLAB_TOKEN=glpat-xxxxxxxxxxxx

# GitLab project ID (found in project settings)
GITLAB_PROJECT_ID=12345

# ===========================================
# Sync & Polling Intervals (in milliseconds)
# ===========================================
# CodeClaude sync interval (default: 30000ms = 30 seconds)
CC_SYNC_INTERVAL=30000

# Message polling interval (default: 5000ms = 5 seconds)
MESSAGE_POLL_INTERVAL=5000

# ===========================================
# Application Settings (Server-side)
# ===========================================
# Default greeting protocol (standard/concise/friendly)
GREETING_PROTOCOL=concise

# Default response verbosity (0-100, default: 50)
RESPONSE_VERBOSITY=50

# Enable auto context injection (true/false)
AUTO_CONTEXT_INJECTION=true

# Enable auto sync changes (true/false)
AUTO_SYNC_CHANGES=false

# ===========================================
# Shadow Clone Settings (Server-side)
# ===========================================
# Shadow clone auto-take tasks (true/false)
SHADOW_AUTO_TAKE=false

# ===========================================
# Claude Code (CC) Webhook Configuration
# ===========================================
# API Key for authenticating incoming CC webhook requests
# Generate a secure key: openssl rand -hex 32
# NOTE: This is optional. API keys can also be managed via the dashboard UI
# (Settings → Integration Console → API Keys)
# If both are configured, database keys take priority
CC_WEBHOOK_API_KEY=

# Alternative API Key name (for backward compatibility)
CC_API_KEY=

# Enable SSE (Server-Sent Events) for real-time updates (true/false)
SSE_ENABLED=true

# SSE heartbeat interval in seconds (default: 30)
SSE_HEARTBEAT_INTERVAL=30

# SSE connection timeout in seconds (default: 300 = 5 minutes)
SSE_CONNECTION_TIMEOUT=300

# ===========================================
# Client-Side Settings (NEXT_PUBLIC_ prefix)
# These are exposed to the browser
# ===========================================
# Default GitLab URL shown in settings form
NEXT_PUBLIC_GITLAB_URL=https://gitlab.example.com

# Default GitLab token shown in settings form
NEXT_PUBLIC_GITLAB_TOKEN=glpat-xxxxxxxxxxxx

# Default local endpoint shown in settings form
NEXT_PUBLIC_LOCAL_ENDPOINT=http://localhost:8080/v1

# Default greeting protocol (standard/concise/friendly)
NEXT_PUBLIC_GREETING_PROTOCOL=concise

# Default response verbosity (0-100, default: 50)
NEXT_PUBLIC_RESPONSE_VERBOSITY=50

# Default auto context injection (true/false)
NEXT_PUBLIC_AUTO_CONTEXT_INJECTION=true

# Default working directory shown in settings form
NEXT_PUBLIC_WORKING_DIRECTORY=/home/user/projects

# Default auto sync changes (true/false)
NEXT_PUBLIC_AUTO_SYNC_CHANGES=false
