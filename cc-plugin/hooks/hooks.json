{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "description": "会话启动时发送心跳",
        "hooks": [
          "bash ${CLAUDE_PLUGIN_ROOT}/scripts/heartbeat.sh"
        ]
      }
    ],
    "ToolExecution": [
      {
        "matcher": "Bash",
        "description": "命令执行后发送进度更新",
        "throttle": 30000,
        "hooks": [
          "bash ${CLAUDE_PLUGIN_ROOT}/scripts/report-progress.sh --throttled"
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "description": "会话结束时报告当前进度",
        "hooks": [
          "bash ${CLAUDE_PLUGIN_ROOT}/scripts/report-progress.sh --final"
        ]
      }
    ],
    "TaskComplete": [
      {
        "matcher": "",
        "description": "任务完成后自动调用",
        "hooks": [
          "bash ${CLAUDE_PLUGIN_ROOT}/scripts/report-complete.sh"
        ]
      }
    ]
  },
  "triggers": {
    "autoPoll": {
      "enabled": false,
      "interval": 60000,
      "description": "定期轮询新任务"
    },
    "autoHeartbeat": {
      "enabled": true,
      "interval": 300000,
      "description": "定期发送心跳"
    },
    "autoSync": {
      "enabled": false,
      "description": "自动同步任务状态"
    }
  }
}
